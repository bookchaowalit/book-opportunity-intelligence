# Free-only defaults for book-opportunity-intelligence (synthesis consumer)
# Copy to .env locally if needed. Never commit real secrets.

FREE_ONLY=true
ALLOW_PAID_PROVIDERS=false
ALLOW_EXTERNAL_WRITES=false
API_HOST=127.0.0.1
API_PORT=8108
ALLOW_REFRESH=false
# REFRESH_TOKEN=  # only if you intentionally enable local refresh acknowledgement
REQUEST_TIMEOUT_SECONDS=4
MAX_RETRIES=1
STALE_AFTER_HOURS=24
DOMAIN_FETCH_LIMIT=50

# Optional credentials are NEVER required and are ignored in free-only mode.
# Leave unset. Do not put real keys here.
# FIRECRAWL_API_KEY=
# TEQUILA_API_KEY=
# BRAVE_API_KEY=
# TELEGRAM_TRADING_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TODOIST_API_TOKEN=
